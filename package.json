{
  "name": "cat-companion",
  "version": "0.1.0",
  "description": "A macOS desktop companion that lets Momo (ragdoll) and Java (Russian blue) live in your dock, wander your desktop, and remind you to take breaks.",
  "main": "src/main/main.js",
  "author": "haoshuo",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build:icons": "electron scripts/build-icons.js",
    "postinstall": "electron scripts/build-icons.js || true",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.haoshuo.catcompanion",
    "productName": "Cat Companion",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "src/assets/icons/app.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
