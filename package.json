{
  "name": "purrtners",
  "version": "0.2.0",
  "description": "A macOS desktop cat companion with photo-based pet poses, Dock presence, wandering behavior, and break reminders.",
  "main": "src/main/main.js",
  "author": "haoshuo",
  "license": "MIT",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron . --enable-logging",
    "build:icons": "python3 scripts/make-photo-icon.py",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:mac:local": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.haoshuo.purrtners",
    "productName": "Purrtners",
    "asar": true,
    "files": [
      "src/**/*",
      "LICENSE",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "src/assets/icons/app.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
